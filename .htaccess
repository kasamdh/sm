<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect the duplicate /index.html URL directly to the canonical homepage.
    RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
    RewriteRule ^index\.html$ https://www.sourcemotionpt.com/ [R=301,L]

    # Force HTTPS and the preferred www hostname.
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} !^www\.sourcemotionpt\.com$ [NC]
    RewriteRule ^ https://www.sourcemotionpt.com%{REQUEST_URI} [R=301,L]
</IfModule>
